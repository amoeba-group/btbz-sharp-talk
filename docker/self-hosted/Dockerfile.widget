# syntax=docker/dockerfile:1
# btbz-SharpTalk — customer Widget (Vite static) image, self-hosted. Served under /widget/.
# Build context MUST be the repo root.

# ---- Build stage ----------------------------------------------------------
FROM node:20-alpine AS build
WORKDIR /app

# VITE_* vars are baked at build time. VITE_BASE makes assets resolve under /widget/.
ARG VITE_API_BASE_URL
ARG VITE_BASE=/widget/
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_BASE=${VITE_BASE}

COPY package.json package-lock.json turbo.json tsconfig.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/widget/package.json apps/widget/
COPY packages/types/package.json packages/types/
COPY packages/common/package.json packages/common/

RUN npm install

COPY . .

RUN npx turbo run build --filter=@sharptalk/widget...

# ---- Runtime stage (nginx static, served under /widget/) -------------------
FROM nginx:alpine AS runtime
# The conf is an envsubst TEMPLATE (PLN-261012 SG-82): the nginx entrypoint renders
# /etc/nginx/templates/*.template into conf.d at container start. Defaults keep an
# unconfigured container identical to before: no frame-ancestors header, Pretendard
# from jsDelivr. See the header of nginx.widget.conf for what each one does.
COPY docker/self-hosted/nginx.widget.conf /etc/nginx/templates/default.conf.template
ENV WIDGET_FRAME_ANCESTORS="" \
    WIDGET_FONT_CSS_URL="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css"
COPY --from=build /app/apps/widget/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
