# Settings for the scheduled backup and restore drill (PLN-261012 SG-81).
#
#   sudo install -m 600 -o sharptalk docker/self-hosted/ops/backup.env.example /etc/sharptalk/backup.env
#
# Read by BOTH schedulers: systemd (EnvironmentFile=, so no `export`, no quotes, no $vars)
# and cron (the entry sources it). Nothing here is a secret except the PATH to the key —
# the key itself lives in its own file (below), mode 600.

# Where dated backup directories are written. A different disk from the Docker volumes is
# the minimum; a different machine / object store (copied after each run) is the point.
BACKUP_ROOT=/var/backups/sharptalk

# Encrypt every archive (openssl enc -aes-256-cbc -pbkdf2). Create the key ONCE:
#   sudo install -d -m 700 -o sharptalk /etc/sharptalk
#   openssl rand -base64 48 | sudo tee /etc/sharptalk/backup.key >/dev/null
#   sudo chown sharptalk /etc/sharptalk/backup.key && sudo chmod 600 /etc/sharptalk/backup.key
# Then keep a copy of the key where the backups are NOT (password manager / sealed envelope).
# A backup without its key is noise; nothing can recover it.
BACKUP_ENCRYPT_KEY_FILE=/etc/sharptalk/backup.key

# Days of backups to keep on this host (only dated backup directories are ever deleted).
BACKUP_KEEP_DAYS=14

# auto = back up the vector index when Qdrant is configured and running; on = fail if it
# cannot be backed up; off = never.
BACKUP_QDRANT=auto

# Container names, if you changed them in the compose file.
#MYSQL_CONTAINER=sharptalk_mysql
#API_CONTAINER=sharptalk_api
#QDRANT_CONTAINER=sharptalk_qdrant
