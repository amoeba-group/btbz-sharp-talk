# Quarterly trigger for sharptalk-restore-drill.service (PLN-261012 SG-81).
[Unit]
Description=Quarterly SharpTalk restore drill

[Timer]
# 03:30 UTC on the 1st of January, April, July and October — after the 02:30 backup.
OnCalendar=*-01,04,07,10-01 03:30:00 UTC
Persistent=true
RandomizedDelaySec=15min
Unit=sharptalk-restore-drill.service

[Install]
WantedBy=timers.target
