# syntax=docker/dockerfile:1
# btbz-SharpTalk — Web admin (Vite static) image, self-hosted. Amoeba Structure v2 §5.1.
# Build context MUST be the repo root: docker build -f docker/self-hosted/Dockerfile.web .

# Pinned, not floating (PLN-261012 SG-80): `node:20-alpine` moved under every rebuild, so
# two builds of the same commit could differ and a rollback could not be reproduced.
# The tag is an ARG so a customer's private mirror can be used (--build-arg NODE_IMAGE=...).
# No digest is pinned here: one cannot be verified offline, and an invented digest
# fails every build. docker/self-hosted/Dockerfile.* and the compose defaults must
# agree (scripts/__tests__ checks it).
ARG NODE_IMAGE=node:20.19.0-alpine3.21
ARG NGINX_IMAGE=nginx:1.27.5-alpine

# ---- Build stage ----------------------------------------------------------
FROM ${NODE_IMAGE} AS build
WORKDIR /app

# VITE_* vars are baked at build time, so they must be ARGs.
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
# Optional: where the console's install snippets point the widget (a CDN, say).
# Empty = derive it from VITE_API_BASE_URL / the console's own origin
# (apps/web/src/lib/widget-url-resolve.ts) — never Amoeba's host.
ARG VITE_WIDGET_URL=
ENV VITE_WIDGET_URL=${VITE_WIDGET_URL}

# Workspace manifests first (better layer caching for npm ci).
COPY package.json package-lock.json turbo.json tsconfig.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/widget/package.json apps/widget/
COPY packages/types/package.json packages/types/
COPY packages/common/package.json packages/common/

# Reproducible install: exactly what package-lock.json records (see Dockerfile.api).
RUN npm ci

# Source.
COPY . .

# Build @sharptalk/web and its workspace deps (^build).
RUN npx turbo run build --filter=@sharptalk/web...

# The bundled manuals use Amoeba's staging host as their example URL
# (shoptalk.amoeba.site / sharptalk.amoeba.site). On a customer's deployment that
# reads as an instruction to use Amoeba's server, so the host is replaced with this
# deployment's own at build time. Release bundles are built domain-agnostic and
# keep the neutral example host (PLN-261012 SG-80).
ARG MANUAL_HOST=talk.example.com
COPY docker/self-hosted/build-steps/rewrite-manual-host.sh /tmp/rewrite-manual-host.sh
RUN sh /tmp/rewrite-manual-host.sh apps/web/dist/manual "$MANUAL_HOST"

# ---- Runtime stage (nginx static) -----------------------------------------
FROM ${NGINX_IMAGE} AS runtime
COPY docker/self-hosted/nginx.web.conf /etc/nginx/conf.d/default.conf

# Which other origins may frame the console. Default: none — `frame-ancestors 'self'`.
# This used to hard-code Amoeba's AMA portal for every customer; an operator who
# really embeds the console elsewhere lists that origin here (space-separated).
ARG CONSOLE_FRAME_ANCESTORS=
COPY docker/self-hosted/build-steps/render-frame-ancestors.sh /tmp/render-frame-ancestors.sh
RUN sh /tmp/render-frame-ancestors.sh /etc/nginx/conf.d/default.conf "$CONSOLE_FRAME_ANCESTORS"
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
