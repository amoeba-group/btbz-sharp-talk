# syntax=docker/dockerfile:1
# btbz-SharpTalk — API (NestJS) image, self-hosted. Amoeba Structure v2 §5.1.
# Build context MUST be the repo root: docker build -f docker/self-hosted/Dockerfile.api .

# Pinned, not floating (PLN-261012 SG-80): `node:20-alpine` moved under every rebuild, so
# two builds of the same commit could differ and a rollback could not be reproduced.
# The tag is an ARG so a customer's private mirror can be used (--build-arg NODE_IMAGE=...).
# No digest is pinned here: one cannot be verified offline, and an invented digest
# fails every build. docker/self-hosted/Dockerfile.* and the compose defaults must
# agree (scripts/__tests__ checks it).
ARG NODE_IMAGE=node:20.19.0-alpine3.21

# ---- Build stage ----------------------------------------------------------
FROM ${NODE_IMAGE} AS build
WORKDIR /app

# Workspace manifests first (better layer caching for npm ci).
COPY package.json package-lock.json turbo.json tsconfig.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/widget/package.json apps/widget/
COPY packages/types/package.json packages/types/
COPY packages/common/package.json packages/common/

# `npm ci`, not `npm install`: it installs exactly what package-lock.json records and
# fails when the lock and the manifests disagree, so an image is reproducible from a
# commit and never silently picks up a newer transitive dependency.
RUN npm ci

# Source.
COPY . .

# Build @sharptalk/api and its workspace deps (^build → packages/types, packages/common).
RUN npx turbo run build --filter=@sharptalk/api...

# ---- Runtime stage --------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production

# Built app + workspace package dists + installed deps.
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/packages/types/package.json ./packages/types/package.json
COPY --from=build /app/packages/types/dist ./packages/types/dist
COPY --from=build /app/packages/common/package.json ./packages/common/package.json
COPY --from=build /app/packages/common/dist ./packages/common/dist

EXPOSE 3000
CMD ["node", "apps/api/dist/main.js"]
