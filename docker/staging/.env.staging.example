# btbz-SharpTalk — STAGING environment template. Amoeba Structure v2 §5.1.
# Copy to docker/staging/.env.staging and fill in real values.
# The real .env.staging is gitignored — NEVER commit secrets.

NODE_ENV=staging
PORT=3000
API_PREFIX=api/v1

# --- MySQL ---------------------------------------------------------------
# DB_HOST=mysql matches the compose service name on the internal network.
DB_HOST=mysql
DB_PORT=3306
DB_USER=sharptalk
DB_PASSWORD=change_me_staging_db_pw
DB_NAME=db_sharptalk
# Root password is consumed by the mysql container only.
DB_ROOT_PASSWORD=change_me_staging_root_pw
# Staging runs migrations too (since 2026-07-31): apply sql/*.sql BEFORE the code.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Redis ---------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- RabbitMQ ------------------------------------------------------------
RABBITMQ_USER=sharptalk
RABBITMQ_PASSWORD=change_me_staging_mq_pw
RABBITMQ_URL=amqp://sharptalk:change_me_staging_mq_pw@rabbitmq:5672

# --- Uploads (FIX-260911) ------------------------------------------------
# Must equal the compose volume mount (/data/uploads); otherwise attachments are
# written inside the container and vanish on the next deploy.
UPLOAD_DIR=/data/uploads

# --- Knowledge search (vector) --------------------------------------------
# Without QDRANT_URL the KB falls back to MySQL full-text only; without
# VOYAGE_API_KEY nothing is embedded (Korean/Vietnamese search degrades badly).
QDRANT_URL=http://qdrant:6333
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- CORS (SEC-L1) --------------------------------------------------------
# Comma-separated browser origins allowed to call the API cross-origin.
# Leave unset when web/widget/api are served same-origin behind the edge proxy
# (the default compose topology) - no CORS headers are then emitted.
# CORS_ORIGINS=https://admin.example.com,https://widget.example.com

# --- JWT (Access 1h / Refresh 7d) ---------------------------------------
JWT_ACCESS_SECRET=change_me_staging_access_secret
JWT_REFRESH_SECRET=change_me_staging_refresh_secret
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# --- Credential + PII encryption (AES-256-GCM, 32 bytes base64, POL-018) --
# Also encrypts customer PII at rest + keys the email_hash blind index (PRV-M6).
# MUST stay stable — rotating it requires decrypt-with-old-key + db:migrate-pii.
CRED_ENC_KEY=change_me_base64_32_byte_key

# --- AI gateway ----------------------------------------------------------
AI_DEFAULT_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Region named in the widget AI disclosure (US EU VN KR JP SG). REQ-260913 G7.
AI_PROCESSING_REGION=US

# --- Retention -----------------------------------------------------------
# Idle conversation sweep (PLN-260810). 0 disables it entirely.
IDLE_SWEEP_INTERVAL_SEC=30
IDLE_PROMPT_AFTER_MIN=30
IDLE_CLOSE_AFTER_SEC=60
# Older than this closes silently — no "anything else?" to a weeks-old thread.
IDLE_STALE_AFTER_DAYS=7

CONVERSATION_LOG_RETENTION_DAYS=90
# Scheduled purge cadence (hours). Runs messages/conversations/cjm/notifications/
# stale-session disposal past the retention window; 0 disables the scheduler.
RETENTION_PURGE_INTERVAL_HOURS=24
# AI token usage roll-ups are kept LONGER than conversations, on their own
# window: those rows hold no personal data — they are counters — and 13 months
# is what makes "this month against the same month last year" answerable.
# Disposing of them on the conversation clock would quietly remove that.
AI_USAGE_RETENTION_DAYS=400

# MySQL connection pool size per API instance (PERF-17). Default 30.
DB_POOL_SIZE=30

# --- Bootstrap (self-seed on boot; no ts-node in the image) --------------
# SEED_ON_BOOT runs the idempotent bootstrap seed at API startup (tenant ivyusa,
# admin@/dev@ accounts — must change password on first login).
# Baseline KB on first boot: us-cosmetics | none (REQ-260913 G11).
SEED_KB_PROFILE=us-cosmetics
SEED_ON_BOOT=true
# Baseline KB on first boot: us-cosmetics | none (REQ-260913 G11).
SEED_KB_PROFILE=us-cosmetics
SEED_DEMO_DATA=true            # set false for a clean staging without demo orders
# SEED_PASSWORD=                # override the default bootstrap password (recommended)

# --- Shopify webhook verification (GDPR compliance webhooks) -------------
# REQUIRED outside dev: the API rejects Shopify webhooks (incl. shop/redact) when unset.
SHOPIFY_WEBHOOK_SECRET=

# --- Generic fulfillment webhook (X-Webhook-Secret header) ---------------
# REQUIRED outside dev: /webhooks/fulfillment rejects requests without a match.
FULFILLMENT_WEBHOOK_SECRET=

# --- Frontend build-time (baked into the web image) ----------------------
VITE_API_BASE_URL=https://staging.sharptalk.example.com/api/v1
# Storefront host shown by the PWA "shop" button and sent as shop_domain.
VITE_SHOP_DOMAIN=ambshop-dev.myshopify.com

# --- Web Push (PWA) — generate once: npx web-push generate-vapid-keys ----
# Without these the API boots fine but web push sends are skipped (warn).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@amoeba.group

# Operational alert mail (PLN-261012 SG-80). The code no longer defaults these to Amoeba:
# AI-engine credit / golden-gate alerts go to AI_ALERT_EMAIL, else ALERT_EMAIL_TO, else nobody.
# Amoeba's own staging says so explicitly.
AI_ALERT_EMAIL=dev@amoeba.group
# Escalation / UNCLAIMED alert mail subject prefix. Blank = [SharpTalk]; staging keeps the old IVY text.
ALERT_EMAIL_SUBJECT_PREFIX="[IVY Chat]"

# MFA enrollment enforcement (PLN-MFA Stage M3). ISO date; unset = advisory off.
# From this date, admins + master/director without MFA are locked to enrollment routes (E1010).
#MFA_ENFORCE_FROM=2026-08-14

# Product catalog auto-sync from the tenant storefront /products.json, in minutes
# (PLN-260807 F1; 0/unset = disabled). 360 = every 6 hours.
PRODUCT_SYNC_INTERVAL_MIN=360
# Odoo scheduled sync (products + orders); 0 disables (on-demand only). REQ-260826.
ODOO_SYNC_INTERVAL_MIN=0
WOOCOMMERCE_SYNC_INTERVAL_MIN=0
HARAVAN_SYNC_INTERVAL_MIN=0

# Public base URL for app share links (nudge cards at /app/nudge/:code —
# PLN-260807 F2, A-5). Must be the externally reachable PWA origin.
APP_PUBLIC_URL=https://shoptalk.amoeba.site

# Notion source-sync caps (REQ-260828 C4). Optional — defaults 30 / 200.
# Raise the request budget when a single large page reports `truncated`.
NOTION_MAX_REQUESTS_PER_PAGE=30
NOTION_MAX_PAGES_PER_SYNC=200
