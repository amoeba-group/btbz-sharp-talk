# ============================================================================
# SharpTalk-VN-Go2Joy — deployment profile (PLN-260913). Derived from
# docker/self-hosted/.env.self-hosted.example; only the values below differ.
#
#   cp deploy/profiles/SharpTalk-VN-Go2Joy/.env.SharpTalk-VN-Go2Joy.example docker/self-hosted/.env.self-hosted
#   bash scripts/gen-secrets.sh            # paste the generated secrets
#   bash scripts/deploy-self-hosted.sh --check
#
# Placeholders: <DOMAIN> = this deployment's public host (one origin for
# console, widget and API). Never commit the filled-in file.
#
# Profile notes (see docs/guide/GUIDE-260913-SharpTalk-VN-Go2Joy-Staging.md):
#  - Region: Viet Nam (data residency, PDPD). Backups stay in-country.
#  - Retention 180 days is a DRAFT — align with the published privacy notice.
#  - AI_DEFAULT_PROVIDER starts as `stub` for the first smoke test; switch to
#    `anthropic` after the cross-border (US processing) notice is in place.
#  - Shopify/Cafe24 are unused: leave their keys empty, but SHOPIFY_WEBHOOK_SECRET
#    and FULFILLMENT_WEBHOOK_SECRET still need strong random values (boot check).
#  - Messenger webhooks (AmoebaTalk hub, Viber) must be re-registered on this origin.
# ============================================================================

# ---- 1. REQUIRED -----------------------------------------------------------

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Database. DB_HOST is the compose service name unless you point at a managed DB.
DB_HOST=mysql
DB_PORT=3306
DB_USER=sharptalk
DB_PASSWORD=
DB_NAME=db_sharptalk
# Consumed by the mysql image (not the API) to initialise the server.
DB_ROOT_PASSWORD=
# MUST stay false outside development: schema changes are applied as SQL from
# sql/ BEFORE the code that needs them (deploy standard 04 §3).
DB_SYNCHRONIZE=false
DB_LOGGING=false

REDIS_HOST=redis
REDIS_PORT=6379

# The pair below is consumed by the rabbitmq image; the API only reads RABBITMQ_URL.
RABBITMQ_USER=sharptalk
RABBITMQ_PASSWORD=
RABBITMQ_URL=amqp://sharptalk:CHANGE_ME@rabbitmq:5672

# Secrets — 32+ bytes each. The API REFUSES TO BOOT in production if any of
# these is short, missing, or looks like a placeholder.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800
CRED_ENC_KEY=

# Where chat attachments and the widget logo are written. This MUST be the
# mounted volume path. Left unset the API writes inside the container, which
# works — until the next deploy takes every uploaded file with it.
UPLOAD_DIR=/data/uploads

# The public origin of THIS deployment. Push links, e-mail links and the
# messenger webhook base are built from it; unset, some of them fall back to
# Amoeba's own staging host, which is not where your customers should land.
APP_PUBLIC_URL=https://talk-vn.<DOMAIN>
PUBLIC_BASE_URL=https://talk-vn.<DOMAIN>

# Browser origins allowed to call this API (console + widget host). Empty in
# production means no CORS headers at all, which is right only when everything
# is served same-origin through this stack's nginx.
# Go2Joy: list the Hotel Admin origin(s) here — exact scheme+host(+port), no
# trailing slash, no wildcard — because the embed loader calls
# /api/v1/public/widget/visibility from that page
# (docs/guide/GUIDE-261013-Go2Joy-HotelAdmin-CSP-CORS.md section 4).
CORS_ORIGINS=

# Bootstrap. Leave SEED_ON_BOOT=false after the first run, or a restart may
# resurrect seeded accounts.
SEED_ON_BOOT=false
SEED_DEMO_DATA=false
SEED_PASSWORD=

# Who the first boot creates (PLN-261012 SG-80). Blank = the developer defaults (tenant
# "ivyusa", admin@ / dev@amoeba.group) - fine on a laptop, WRONG on your own infrastructure.
# For a single-tenant install set ALL of the first five; deploy-self-hosted.sh refuses a
# half-configured set. SEED_TENANT_DOMAIN is the host the widget identifies the tenant by
# (a non-storefront tenant uses its app host). With NODE_ENV=production and no SEED_PASSWORD /
# SEED_ADMIN_PASSWORD, one-time passwords are GENERATED and printed once:
#   docker logs sharptalk_api 2>&1 | grep -A4 'SEED CREDENTIALS'
SEED_TENANT_SLUG=go2joy
SEED_TENANT_NAME=Go2Joy
SEED_TENANT_DOMAIN=app.go2joy.vn
SEED_ADMIN_EMAIL=
SEED_MASTER_EMAIL=
SEED_ADMIN_PASSWORD=

# Built into the browser bundles at image build time (not read at runtime).
VITE_API_BASE_URL=https://talk-vn.<DOMAIN>/api/v1

# Image delivery and logs (PLN-261012 SG-80/81). deploy-self-hosted.sh sets the version tag
# itself; override the prefix only for a private registry. Docker rotates each container's
# log at LOG_MAX_SIZE, keeping LOG_MAX_FILE files.
#SHARPTALK_IMAGE_PREFIX=sharptalk
#SHARPTALK_VERSION=
LOG_MAX_SIZE=20m
LOG_MAX_FILE=5
# Build-time, read by the web image: extra origins allowed to FRAME the console
# (default none - the console may only frame itself) and the widget URL the console's
# install snippets show (blank = this deployment's own origin, never Amoeba's host).
CONSOLE_FRAME_ANCESTORS=
VITE_WIDGET_URL=

# ---- 2. FEATURES -----------------------------------------------------------

# AI. `stub` answers without calling anyone — useful for a first smoke test.
# Read by the AI gateway's own resolver rather than ConfigService.
AI_DEFAULT_PROVIDER=stub
ANTHROPIC_API_KEY=
# The console's AI settings override this per tenant once configured; this is
# the value used before anyone has chosen one.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=
# Where AI inference runs. Named in the widget's AI disclosure ("processed by a
# third-party AI service provider in <region>"). Codes: US EU VN KR JP SG.
AI_PROCESSING_REGION=US
# Baseline knowledge seeded on first boot: us-cosmetics (US CS policy docs) or
# none (empty KB — for tenants that bring their own knowledge).
SEED_KB_PROFILE=none

# Knowledge base vector search. Without QDRANT_URL the KB falls back to
# full-text only; without VOYAGE_API_KEY nothing is embedded.
QDRANT_URL=http://qdrant:6333
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# Attachment links. Derived from CRED_ENC_KEY when unset — set it explicitly if
# you ever need to rotate link signing without touching stored credentials.
FILE_URL_SECRET=

# Embed SDK (PLN-260819). Enforce refuses widgets embedded on domains the tenant
# did not allow; start with false and read the warnings before turning it on.
EMBED_ORIGIN_ENFORCE=false
# Signed identity from ShopTalk.identify() (PLN-261012 SG-03 / SG-04).
# Hours a signed identity stays trusted; older claims are treated as a guest until the host
# signs again. Blank = 8. 0 switches expiry OFF platform-wide (emergency rollback only).
# A tenant can override the hours in the console (Settings > Widget > Signed sign-in policy).
IDENTITY_MAX_AGE_HOURS=
# A signed identify can be used by ONE widget session inside its 10-minute window (replay
# guard, needs Redis). Blank/true = on; false = off (emergency rollback only).
IDENTIFY_REPLAY_GUARD=

# Widget container settings (PLN-261012 SG-82; read by docker compose, not the API).
#  WIDGET_FRAME_ANCESTORS: space-separated ORIGINS allowed to put the widget in an
#    iframe, e.g. https://admin.example.vn. Blank = no frame-ancestors header (any
#    site may embed it). Origins only; add 'self' if you also open the widget URL
#    in its own tab.
#  WIDGET_FONT_CSS_URL: base font stylesheet. UNSET (leave the line out) = Pretendard
#    from jsDelivr; a path/URL = that stylesheet (self-host it, see
#    docs/guide/GUIDE-261013-Go2Joy-HotelAdmin-CSP-CORS.md section 5); EMPTY =
#    system fonts only. Plain URL or path: no quotes, spaces or semicolons.
WIDGET_FRAME_ANCESTORS=
# Go2Joy: the bundled Pretendard copy, so the widget iframe makes no CDN request.
WIDGET_FONT_CSS_URL=/widget/fonts/pretendard/pretendard.css

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_SCOPES=
SHOPIFY_WEBHOOK_SECRET=
FULFILLMENT_WEBHOOK_SECRET=

# Cafe24
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REDIRECT_URI=
CAFE24_SCOPES=
CAFE24_CUSTOMER_REDIRECT_URI=
CAFE24_CUSTOMER_SCOPES=
CAFE24_CONSOLE_RETURN_URL=
CAFE24_API_HOST_TEMPLATE=
CAFE24_AUTH_HOST_TEMPLATE=
CAFE24_API_VERSION=

# External messengers (relay / hub / Telegram / Gmail). The webhook base must be
# reachable from the internet for webhook-based channels.
MESSENGER_WEBHOOK_BASE_URL=https://talk-vn.<DOMAIN>

# AMA single sign-on (Amoeba portal); leave blank unless you use it.
AMA_SSO_CLIENT_ID=
AMA_SSO_CLIENT_SECRET=
AMA_SSO_TOKEN_URL=

# Outbound mail (off-hours replies, alerts).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Sender of those mails. Blank = SMTP_USER, else noreply@<host of APP_PUBLIC_URL>.
ALERT_EMAIL_FROM=
# Prefix of the alert e-mail subject ("<prefix> Escalation - conversation #N"). Blank = [SharpTalk].
ALERT_EMAIL_SUBJECT_PREFIX=
# AI engine out-of-credit / recovery mail (PLN-261007-AI-Credit-Alert). Blank = ALERT_EMAIL_TO; both blank = nobody is mailed (no Amoeba default).
AI_ALERT_EMAIL=
# Post-deploy FAQ regression gate (PLN-261008): tenantId:aiAgentId[,…]. Blank = off.
GOLDEN_GATE=
ALERT_EMAIL_TO=
SLACK_WEBHOOK_URL=
# Agent presence for alert routing (PLN-261012 SG-60): seconds an on-duty agent stays "present"
# after the console last polled. Blank = 90.
AGENT_PRESENCE_TTL_SEC=
# Unclaimed-conversation re-alert (PLN-261012 SG-63): minutes a waiting conversation may sit with nobody
# taking it before a fresh broadcast alert + an UNCLAIMED Slack/email message (0 = off, blank = 5);
# re-pages per conversation (blank = 3); how often the sweep looks, seconds (blank = 30).
ALERT_UNCLAIMED_MINUTES=
ALERT_UNCLAIMED_MAX_PAGES=
ALERT_UNCLAIMED_SWEEP_SEC=

# Partner data lookup (PLN-261012 SG-30/31/32): live hotel rates/policies/bookings/settlement for signed-in
# partner users. OFF unless PARTNER_DATA_ENABLED is 1 AND the tenant switches it on (Settings -> Etc).
# PARTNER_API_MODE: mock (built-in sample hotels, the default) | live (Go2Joy's API; needs R8/R9 and the
# tenant's go2joy_partner_api credentials). Draft contract: docs/guide/API-REQ-Go2Joy-Partner-Data.openapi.yaml
PARTNER_DATA_ENABLED=
PARTNER_API_MODE=
# Seconds / ms; blank = 28800 (8 h) / 3000 / 7000.
PARTNER_CLAIMS_MAX_AGE_SEC=
PARTNER_API_TIMEOUT_MS=
PARTNER_API_BUDGET_MS=
# Hostnames the operator allows although private / plain http (comma separated). Blank = public https only.
PARTNER_API_PRIVATE_HOSTS=
# Model-driven lookups (PLN-261012 SG-33, OPTIONAL — see docs/guide/GUIDE-261013-Partner-Data-Tools-Mode.md).
# PARTNER_DATA_MODE: prefetch (the default: the server fetches what a keyword detector names before the
# model runs) | tools (the model chooses read-only lookups through native tool calling, behind the same
# checks; falls back to prefetch when the AI engine cannot do tools). A tenant can override it in Settings.
# Needs an AI engine whose capabilities include `tools`. Verified only against a fake provider.
PARTNER_DATA_MODE=
# Server-wide kill switch: 0 forces every tenant back to prefetch. Blank = allowed (nothing runs in tools
# mode until PARTNER_DATA_MODE or a tenant override asks for it).
PARTNER_TOOLS_ENABLED=
# Limits per customer turn; blank = 3 model calls / 4 tool calls / 20000 ms / 512 output tokens per call.
PARTNER_TOOLS_MAX_ITERATIONS=
PARTNER_TOOLS_MAX_CALLS=
PARTNER_TOOLS_BUDGET_MS=
PARTNER_TOOLS_MAX_TOKENS=
# --- Resilience, observability and ops alerting (PLN-261012 SG-83 / SG-84) ---------------------
# Every value below is optional. See docs/guide/GUIDE-261013-Observability-Alerting.md.
# Provider deadlines / breaker (blank = default): completion 25000 ms, embedding 8000 ms, Qdrant 5000 ms;
# the breaker opens an engine after 5 consecutive failures and skips it for 30 s before one probe.
AI_REQUEST_TIMEOUT_MS=
EMBED_REQUEST_TIMEOUT_MS=
QDRANT_REQUEST_TIMEOUT_MS=
AI_BREAKER_FAILURE_THRESHOLD=
AI_BREAKER_OPEN_SEC=
# Prometheus scrape + dependency readiness (GET /metrics, GET /api/v1/health/readiness). Long random
# token; blank = both endpoints are 404. Scrape the API container port directly — do not publish /metrics.
METRICS_TOKEN=
# Backup/deploy failure hook (POST /api/v1/internal/ops-alert). Blank = 404.
OPS_ALERT_TOKEN=
# Where operational alerts go. NO default recipient: with both blank, alerts are only logged.
OPS_ALERT_EMAIL=
OPS_ALERT_WEBHOOK_URL=
# Optional: scrubbed server-error webhook, and Sentry (only if @sentry/node is installed in the image).
ERROR_WEBHOOK_URL=
SENTRY_DSN=

# Web push (PWA) and the mobile app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
EXPO_PUSH_ACCESS_TOKEN=

# ---- 3. TUNING -------------------------------------------------------------

# Data retention. A blank, 0 or invalid value does NOT keep conversations forever:
# the purge falls back to 365 days (retention.service). Set the number your
# published privacy notice promises; the Vietnam notice profile (vn_pdpl) quotes
# this same value to shoppers, so the two cannot drift apart.
CONVERSATION_LOG_RETENTION_DAYS=180
RETENTION_PURGE_INTERVAL_HOURS=24
# Opt-in disposal of two tables the conversation purge never touches (PLN-261012
# SG-70). Both are OFF while blank or 0 — they are legal decisions, not tuning.
#  CUSTOMER_RETENTION_DAYS: customers with no session/order activity for this many
#    days are ANONYMISED (name, email, phone, external ids, claims), not deleted.
#  AUDIT_LOG_RETENTION_DAYS: audit rows older than this are deleted (minimum 90).
#    That also removes consent evidence (consent.*) and DSAR records (dsar.*).
# There is no per-customer legal hold: switch these off BEFORE the next purge run
# while a hold or a regulator request applies. Anything already purged is gone.
CUSTOMER_RETENTION_DAYS=
AUDIT_LOG_RETENTION_DAYS=
# AI token usage roll-ups are kept LONGER than conversations, on their own
# window: those rows hold no personal data — they are counters — and 13 months
# is what makes "this month against the same month last year" answerable.
AI_USAGE_RETENTION_DAYS=400

# Idle-conversation sweep
IDLE_SWEEP_INTERVAL_SEC=30
IDLE_PROMPT_AFTER_MIN=30
IDLE_CLOSE_AFTER_SEC=60
IDLE_STALE_AFTER_DAYS=7

# Polling intervals
MESSENGER_SYNC_INTERVAL_SEC=15
MESSENGER_OUTBOX_INTERVAL_SEC=5
SHOPIFY_SYNC_INTERVAL_MIN=0
CAFE24_SYNC_INTERVAL_MIN=0
# Odoo scheduled sync (products + orders); 0 disables (on-demand only).
ODOO_SYNC_INTERVAL_MIN=0
WOOCOMMERCE_SYNC_INTERVAL_MIN=0
HARAVAN_SYNC_INTERVAL_MIN=0
CAFE24_LOGIN_SYNC_LOOKBACK_DAYS=90
PRODUCT_SYNC_INTERVAL_MIN=0
PUSH_RECEIPT_SWEEP_MIN=15
KNOWLEDGE_GAP_INTERVAL_HOURS=24
QUESTION_STATS_INTERVAL_HOURS=24
# How many recent days each run checks for missing snapshots. The job normally
# aggregates yesterday; a container that is down when its turn comes would
# otherwise leave that day empty for good.
QUESTION_STATS_BACKFILL_DAYS=7

# Retrieval + answer reuse
RAG_MIN_SIMILARITY=
# Knowledge answers (PLN-261007-Go2Joy-FAQ-Accuracy R3/R4). Blank = default.
# Chars of each document the model sees (default 2000; longer docs send the matching paragraphs).
RAG_SNIPPET_CHARS=
# Total chars across all documents in one answer (default 9000).
RAG_CONTEXT_CHARS=
# Output token limit for a knowledge answer (default 2048).
RAG_MAX_TOKENS=
ANSWER_REUSE_ENABLED=
ANSWER_REUSE_THRESHOLD=
ANSWER_REUSE_MIN_CONFIDENCE=
ANSWER_REUSE_TTL_DAYS=

# Attachments
ATTACHMENT_ALLOW_HEIC=true

# Multi-factor authentication becomes mandatory for console users from this date.
MFA_ENFORCE_FROM=

DB_POOL_SIZE=10
