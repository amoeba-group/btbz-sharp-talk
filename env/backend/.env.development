# Backend (apps/api) — development. Committed per Amoeba Structure v2 (dev only).
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# MySQL (utf8mb4 / InnoDB) — matches chat-widget-schema.sql
DB_HOST=127.0.0.1
DB_PORT=3316
DB_USER=sharptalk
DB_PASSWORD=sharptalk_dev_pw
DB_NAME=db_sharptalk
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis (session cache, unread counts — tenant-prefixed keys)
REDIS_HOST=127.0.0.1
REDIS_PORT=6389

# RabbitMQ (async notifications, logging, cjm)
RABBITMQ_URL=amqp://sharptalk:sharptalk_dev_pw@127.0.0.1:5682

# JWT (Access 15m / Refresh 7d — amoeba_basic_SPEC token policy)
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_0123456789
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# AES-256-GCM key for credential encryption (POL-018). 32 bytes, base64.
CRED_ENC_KEY=ZGV2X29ubHlfMzJieXRlX2tleV9mb3JfYWVzMjU2Z2M=

# AI gateway — stub works without keys; set to use real providers
AI_DEFAULT_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# OpenAI is a spare route: engines configured in the console carry their own
# encrypted key, these are only the fallback when a row has none.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Vector search (KB hybrid RAG — PLAN-KB-VectorHybrid-Qdrant). Empty QDRANT_URL
# disables the vector leg; retrieval falls back to MySQL FULLTEXT only.
QDRANT_URL=http://127.0.0.1:6343
# Voyage AI embeddings (voyage-4). Empty key = deterministic stub vectors (dev).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
# Minimum top-similarity for a confident RAG answer; below this we escalate.
RAG_MIN_SIMILARITY=0.5

# Local file storage for KB uploads (dev)
KB_STORAGE_DIR=./storage/kb

# Data retention / disposal (POL-003) — conversation logs purged after N days.
# Idle conversation sweep (PLN-260810). 0 disables it entirely.
IDLE_SWEEP_INTERVAL_SEC=30
IDLE_PROMPT_AFTER_MIN=30
IDLE_CLOSE_AFTER_SEC=60
# Older than this closes silently — no "anything else?" to a weeks-old thread.
IDLE_STALE_AFTER_DAYS=7

# Chat attachments (PLN-260814). UPLOAD_DIR must point at a MOUNTED path in any
# containerised environment — the API image is rebuilt on every deploy, so files
# written to the container's own filesystem do not survive it.
UPLOAD_DIR=./.uploads
# Signing key for attachment download links. Falls back to a value derived from
# CRED_ENC_KEY when unset, so an environment that has not added it still boots
# with links that cannot be forged; rotating it invalidates existing links.
FILE_URL_SECRET=
ATTACHMENT_MAX_IMAGE_MB=10
ATTACHMENT_MAX_FILE_MB=20
ATTACHMENT_MAX_PER_MESSAGE=5

# Attachments are disposed of on the same schedule as the conversation they
# belong to — rows AND the files on disk (PLN-260814 SI-5).
CONVERSATION_LOG_RETENTION_DAYS=365
# Scheduled purge cadence (hours). Runs messages/conversations/cjm/notifications/
# stale-session disposal past the retention window; 0 disables the scheduler.
RETENTION_PURGE_INTERVAL_HOURS=24
# AI token usage roll-ups are kept LONGER than conversations, on their own
# window: those rows hold no personal data — they are counters — and 13 months
# is what makes "this month against the same month last year" answerable.
# Disposing of them on the conversation clock would quietly remove that.
AI_USAGE_RETENTION_DAYS=400

# MySQL connection pool size per API instance (PERF-17). Default 30.
DB_POOL_SIZE=30

# Shopify scheduled auto-sync interval in minutes (0/unset = disabled).
SHOPIFY_SYNC_INTERVAL_MIN=0

# Escalation alerts (PLAN-Scenario-Handoff-Alert). Empty values disable a channel;
# the console alarm modal (DB-backed) always works.
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=alerts@ivyusa.local
ALERT_EMAIL_TO=

# Shopify public-app OAuth (path B). Empty API key/secret disables the endpoints.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Must match shopify.app.toml: what a store grants is the INTERSECTION of the
# two. read_products (2026-09-20) carries the order line's variant title and
# picture; a store keeps its old grant until it re-authorises.
SHOPIFY_SCOPES=read_orders,read_customers,read_fulfillments,read_products
SHOPIFY_APP_URL=http://localhost:3000

# Shared secret for the generic fulfillment webhook (X-Webhook-Secret header).
# Empty is allowed ONLY when NODE_ENV=development; staging/prod fail closed.
FULFILLMENT_WEBHOOK_SECRET=

# MFA enrollment enforcement (PLN-MFA Stage M3). ISO date; unset = advisory off.
# From this date, admins + master/director without MFA are locked to enrollment routes (E1010).
#MFA_ENFORCE_FROM=2026-08-14

# Web Push (PWA) - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BGks1FuBCvErBQnjaBlpxLyi9005sdt8bqzPQDw52gCN0Q4HPvzZ-XFxGqh6XhN6oJQOB-HfWKhn4g6zOA4Otks
VAPID_PRIVATE_KEY=p6qp7y8wHbifasC6x-GNvouF3urvE8imQtWaLwqLe38
VAPID_SUBJECT=mailto:dev@amoeba.group

# Product catalog auto-sync from the tenant storefront /products.json, in minutes
# (PLN-260807 F1; 0/unset = disabled — trigger manually via POST /admin/products/sync).
PRODUCT_SYNC_INTERVAL_MIN=0
# Odoo scheduled sync (products + orders); 0 disables (on-demand only). REQ-260826.
ODOO_SYNC_INTERVAL_MIN=0
WOOCOMMERCE_SYNC_INTERVAL_MIN=0
HARAVAN_SYNC_INTERVAL_MIN=0

# Public base URL for app share links (nudge cards at /app/nudge/:code —
# PLN-260807 F2, A-5). Dev points at the local PWA; unset falls back to the
# staging PWA host.
APP_PUBLIC_URL=http://localhost:5175

# AMA portal SSO (PLN-260813-AMA-Iframe-SSO S2). All three set = feature on;
# any missing = /auth/sso/ama answers E5029 (disabled). Client credentials come
# from the AMA partner-app registration (docs/guide/AMA-SSO-INTEGRATION.md).
AMA_SSO_TOKEN_URL=https://ama.amoeba.site/api/v1/oauth/token
AMA_SSO_CLIENT_ID=
AMA_SSO_CLIENT_SECRET=
